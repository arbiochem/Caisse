@model ClosureVm
@{
    var session = Model.Session;
    var windowOpen = Model.WindowStatus == "OPEN";
    var windowMessage = Model.WindowStatus == "BEFORE"
        ? "La clôture sera disponible à partir de 11 h 00, heure de Madagascar."
        : "La plage normale est terminée. Une clôture oubliée devra être régularisée par un superviseur.";
    var existing = Model.Existing;
    var label = Domain.CompanyLabel(Model.Company);
    var required = Model.Required;
    var closedRequired = required.Count(c => Model.IsDone(c.Code));
    var canSubmit = windowOpen && session != null && session.Status == "OPEN" && existing == null;
    var submitLabel = !windowOpen ? "Clôture disponible de 11 h à 18 h 30" : existing != null ? label + " déjà clôturée" : "Clôturer " + label;
    var movement = Model.CashMovement;
    var variance0 = -Model.Theoretical;
}
<div class="view-stack" id="closure-view" data-agency="@Model.AgencyCode" data-company="@Model.Company" data-theoretical="@Model.Theoretical" data-window="@Model.WindowStatus" data-close-url="@Url.Action("CloseCompany", "Closure")" data-finalize-url="@Url.Action("Finalize", "Closure")" data-can-submit="@(canSubmit ? "1" : "0")" data-window-message="@windowMessage">
    <section class="section-title"><div><p class="eyebrow">RAPPROCHEMENT PAR SOCIÉTÉ</p><h1>Clôture journalière</h1><p>Chaque société possède son comptage, son solde reporté et son rapport distinct.</p></div>
        @if (session != null && session.Status == "CLOSED")
        {
            <span class="secure-chip">@Icons.Icon("lock", 14) Fermée à @Fmt.Time(session.ClosedAt)</span>
        }
        else
        {
            <span class="deadline-badge">@Icons.Icon("clock", 15) @Domain.RegularClosureWindowLabel</span>
        }
    </section>
    @if (session == null)
    {
        <section class="session-required"><div>@Icons.Icon("warning", 20)<p><strong>Caisse non ouverte pour @Model.AgencyName</strong><span>Une ouverture en ligne est nécessaire avant la clôture.</span></p></div><button type="button" class="primary-button" data-open-session>Ouvrir la caisse</button></section>
    }
    @if (session != null && session.Status == "OPEN" && !windowOpen)
    {
        <section class="session-required"><div>@Icons.Icon("clock", 20)<p><strong>Clôture indisponible actuellement</strong><span>@windowMessage</span></p></div></section>
    }
    <section class="panel closure-switcher">
        <label><span>Agence</span><select disabled><option>@Model.AgencyName</option></select></label>
        <div class="company-closure-tabs">
            @foreach (var item in Domain.Companies)
            {
                var done = Model.IsDone(item.Code);
                <button type="button" class="@(Model.Company == item.Code ? "selected" : "") @(done ? "done" : "")" data-nav="@Url.Action("Index", "Closure", new { company = item.Code })"><span>@item.Label</span>@if (done){@Icons.Icon("check", 13)}</button>
            }
        </div>
    </section>
    <form class="closure-layout" id="closure-form" novalidate>
        <div class="closure-main">
            <article class="panel closure-summary">
                <div class="closure-agency"><div><small>Société à clôturer</small><strong>@label</strong></div><div><small>@(session != null ? "Caissier : " + session.CashierName : "Date")</small><strong>@Fmt.Date(MadagascarTime.Today)</strong></div></div>
                <div class="closure-kpis">
                    <div><span>Report précédent</span><strong>@Fmt.Money(Model.Balance?.CarriedBalance ?? 0)</strong></div>
                    <div><span>Fond de caisse</span><strong>@Fmt.Money(Model.Balance?.CashFund ?? 0)</strong></div>
                    <div><span>Mouvements espèces</span><strong class="@(movement < 0 ? "red-text" : "green-text")">@(movement >= 0 ? "+" : "")@Fmt.Money(movement)</strong></div>
                    <div class="highlight"><span>Caisse théorique</span><strong>@Fmt.Money(Model.Theoretical)</strong></div>
                </div>
            </article>
            <article class="panel count-panel">
                <div class="panel-head"><div><h2>Comptage des espèces — @label</h2><p>Saisissez les billets et pièces réellement présents dans cette caisse.</p></div><span class="counted-total">Compté <strong id="counted-total">0 Ar</strong></span></div>
                <div class="denomination-grid">
                    @foreach (var value in Domain.Denominations)
                    {
                        <label><span>@Fmt.Number(value) Ar</span><div><input type="number" min="0" step="1" data-denom="@value" placeholder="0" /><b data-denom-total="@value">= 0 Ar</b></div></label>
                    }
                </div>
            </article>
            <article class="panel variance-panel @(variance0 == 0 ? "balanced" : "has-variance")" id="variance-panel">
                <div><span class="variance-icon" id="var-icon">@Icons.Icon(variance0 == 0 ? "check" : "warning", 21)</span><div><small>Écart de caisse</small><strong id="var-value">@(variance0 > 0 ? "+" : "")@Fmt.Money(variance0)</strong><p id="var-text">@(variance0 == 0 ? "Le comptage correspond à la caisse théorique." : "Un commentaire est obligatoire.")</p></div></div>
                <label><span>Commentaire <span id="comment-star">@(variance0 != 0 ? "*" : "")</span></span><textarea id="closure-comment" rows="3"></textarea></label>
            </article>
            <div class="inline-error" id="closure-error" hidden>@Icons.Icon("warning", 17)<span id="closure-error-text"></span></div>
            <button class="primary-button submit-closure" id="closure-submit" type="submit" @(canSubmit ? "" : "disabled")><span>@submitLabel</span>@Icons.Icon("chevron", 17)</button>
        </div>
        <aside class="closure-side">
            <article class="panel sticky-card"><div class="panel-head"><div><h2>Résumé société</h2><p>@Model.CompanyOps.Count() opération(s)</p></div></div>
                <div class="closure-channel-list">
                    @foreach (var row in Domain.Channels)
                    {
                        <div><span>@Icons.Icon(row.Icon, 16)</span><strong>@row.Short</strong><em>@Fmt.Money(Model.CompanyOps.Where(o => o.Channel == row.Value && o.Direction == "ENTREE").Sum(o => o.Amount))</em></div>
                    }
                </div>
            </article>
            <article class="panel final-close-card"><h2>Fermeture définitive</h2><p>@(required.Count > 0 ? closedRequired + "/" + required.Count + " caisse(s) société clôturée(s)." : "Aucune société active aujourd’hui.")</p>
                <button type="button" class="primary-button full" id="closure-finalize" @(windowOpen && session != null && session.Status == "OPEN" && Model.AllClosed ? "" : "disabled")>Fermer la caisse du jour</button>
                <small>Clôture autorisée de @Domain.RegularClosureWindowLabel, heure de Madagascar. Après fermeture, aucune nouvelle opération ne sera acceptée avant demain 06 h ; les imputations SAGE resteront modifiables.</small>
            </article>
        </aside>
    </form>
</div>
